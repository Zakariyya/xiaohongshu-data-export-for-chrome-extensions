{
  "manifest_version": 3,
  "name": "小红书数据一键导出助手",
  "description": "在日常 Chrome 登录状态下，批量导出小红书创作服务平台账号概览及内容分析数据，按运行时间分文件夹保存。",
  "version": "1.3.0",
  "minimum_chrome_version": "114",
  "permissions": ["tabs", "scripting", "downloads", "storage"],
  "host_permissions": ["https://creator.xiaohongshu.com/*"],
  "action": {
    "default_title": "打开小红书数据导出助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
